{
  "name": "tablescape-studio-app",
  "version": "1.0.2",
  "private": true,
  "description": "Tablescape for iOS and Android with Capacitor 8: the store build opens the hosted app (app.tablescape.vip) with native share, files, haptics and an offline screen; APP_MODE=bundled packages tablescape-studio.html instead.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "capacitor:update:after": "node scripts/fix-ios-spm-paths.mjs",
    "configure": "node scripts/configure.mjs",
    "patch": "node scripts/patch-native.mjs",
    "sync:ios": "node scripts/configure.mjs && cap sync ios",
    "sync:android": "node scripts/configure.mjs && cap sync android && node scripts/patch-native.mjs android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5"
  }
}
